<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold text-gray-800">My Jobs</h1>
  <%= link_to "Score a Job", new_job_path,
      class: "bg-indigo-600 text-white px-4 py-2 rounded hover:bg-indigo-700 text-sm font-medium" %>
</div>

<%# Token usage ring %>
<% pct = current_user.token_usage_pct %>
<div class="bg-white border border-gray-200 rounded-lg p-4 mb-6 flex items-center gap-6">
  <%# SVG ring — circumference of r=20 circle is ~125.7; stroke-dashoffset encodes usage %>
  <svg width="56" height="56" viewBox="0 0 56 56">
    <circle cx="28" cy="28" r="20" fill="none" stroke="#e5e7eb" stroke-width="6"/>
    <circle cx="28" cy="28" r="20" fill="none"
            stroke="<%= pct >= 90 ? '#ef4444' : pct >= 60 ? '#f59e0b' : '#6366f1' %>"
            stroke-width="6"
            stroke-dasharray="125.7"
            stroke-dashoffset="<%= (125.7 * (1 - pct / 100.0)).round(1) %>"
            stroke-linecap="round"
            transform="rotate(-90 28 28)"/>
    <text x="28" y="33" text-anchor="middle" font-size="11" font-weight="600"
          fill="<%= pct >= 90 ? '#ef4444' : '#374151' %>"><%= pct %>%</text>
  </svg>
  <div>
    <p class="text-sm font-medium text-gray-700">Bedrock Token Usage</p>
    <p class="text-xs text-gray-500">
      <%= number_with_delimiter(current_user.tokens_used) %> /
      <%= number_with_delimiter(current_user.token_limit) %> tokens used
    </p>
  </div>
</div>

<%# Filters — auto-submit: select fires immediately, text debounces 400ms %>
<div class="flex flex-wrap gap-3 mb-4">
  <%= form_with url: root_path, method: :get, local: true,
      id: "filter-form", class: "flex gap-2" do |f| %>
    <%= f.text_field :q, value: params[:q], placeholder: "Search title or company...",
        id: "filter-q",
        class: "border border-gray-300 rounded px-3 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400 w-56" %>
    <%= f.select :folder_id,
        options_from_collection_for_select(@folders, :id, :name, params[:folder_id]),
        { include_blank: "All folders" },
        id: "filter-folder",
        class: "border border-gray-300 rounded px-3 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400" %>
  <% end %>
</div>

<script>
  (function() {
    var form   = document.getElementById("filter-form");
    var search = document.getElementById("filter-q");
    var folder = document.getElementById("filter-folder");
    var timer  = null;

    folder.addEventListener("change", function() { form.submit(); });

    search.addEventListener("input", function() {
      clearTimeout(timer);
      timer = setTimeout(function() { form.submit(); }, 400);
    });
  })();
</script>

<% if @jobs.any? %>
  <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-gray-50 border-b border-gray-200">
        <tr>
          <th class="px-4 py-3 text-left font-medium text-gray-600 w-20">Score</th>
          <th class="px-4 py-3 text-left font-medium text-gray-600">Title</th>
          <th class="px-4 py-3 text-left font-medium text-gray-600">Company</th>
          <th class="px-4 py-3 text-left font-medium text-gray-600">Resume</th>
          <th class="px-4 py-3 text-left font-medium text-gray-600">Folder</th>
          <th class="px-4 py-3 text-left font-medium text-gray-600">Status</th>
          <th class="px-4 py-3 text-left font-medium text-gray-600">Date</th>
          <th class="px-4 py-3 w-10"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @jobs.each do |job| %>
          <tr class="hover:bg-gray-50">
            <td class="px-4 py-3">
              <% if job.scored? && job.score %>
                <% color = job.score_color %>
                <span class="inline-flex items-center justify-center w-10 h-10 rounded-full text-sm font-bold
                  <%= color == 'green' ? 'bg-green-100 text-green-800' :
                      color == 'yellow' ? 'bg-yellow-100 text-yellow-800' :
                      'bg-red-100 text-red-800' %>">
                  <%= job.score %>
                </span>
              <% elsif job.processing? %>
                <span class="text-gray-400 text-xs">...</span>
              <% else %>
                <span class="text-gray-300">-</span>
              <% end %>
            </td>
            <td class="px-4 py-3 font-medium">
              <%= link_to job.title.presence || "(untitled)", job_path(job),
                  class: "text-indigo-600 hover:underline" %>
            </td>
            <td class="px-4 py-3 text-gray-600"><%= job.company.presence || "-" %></td>
            <td class="px-4 py-3 text-gray-500 text-xs"><%= job.resume.name %></td>
            <td class="px-4 py-3 text-gray-500 text-xs"><%= job.folder&.name || "-" %></td>
            <td class="px-4 py-3">
              <% badge_class = case job.status
                 when "scored"  then "bg-green-100 text-green-700"
                 when "scoring" then "bg-yellow-100 text-yellow-700"
                 when "pending" then "bg-gray-100 text-gray-600"
                 when "error"   then "bg-red-100 text-red-700"
                 end %>
              <span class="px-2 py-0.5 rounded text-xs font-medium <%= badge_class %>">
                <%= job.status.capitalize %>
              </span>
            </td>
            <td class="px-4 py-3 text-gray-400 text-xs">
              <%= job.created_at.strftime("%b %d") %>
            </td>
            <td class="px-4 py-3">
              <%= form_with url: job_path(job), method: :delete, local: true,
                  data: { confirm: "Delete this job?" } do %>
                <%= submit_tag "✕", class: "text-gray-300 hover:text-red-500 text-xs bg-transparent border-0 cursor-pointer p-0" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="text-center py-16 text-gray-500">
    <p class="text-lg mb-3">No jobs yet.</p>
    <%= link_to "Score your first job →", new_job_path,
        class: "text-indigo-600 hover:underline" %>
  </div>
<% end %>

<% if @jobs.any?(&:processing?) %>
  <div id="auto-refresh-bar"
       class="fixed bottom-4 right-4 bg-indigo-700 text-white text-xs px-4 py-2 rounded-full shadow-lg flex items-center gap-2">
    <span class="inline-block w-2 h-2 bg-white rounded-full animate-pulse"></span>
    <span id="auto-refresh-label">Scoring in progress — refreshing…</span>
  </div>
  <script>
    // Reload every 5 s while jobs are pending/scoring.
    // Server decides when to stop by omitting this block.
    setTimeout(function() { window.location.reload(); }, 5000);
  </script>
<% end %>

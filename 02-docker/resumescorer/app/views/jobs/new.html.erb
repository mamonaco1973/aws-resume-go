<div class="max-w-2xl">
  <div class="mb-4">
    <%= link_to "← Dashboard", root_path, class: "text-indigo-600 hover:underline text-sm" %>
  </div>

  <h1 class="text-2xl font-bold text-gray-800 mb-6">Score a Job</h1>

  <% if @resumes.empty? %>
    <div class="bg-white border border-gray-200 rounded-lg p-10 text-center">
      <p class="text-gray-600 mb-4">You need to add a resume before you can score jobs.</p>
      <%= link_to "Add a Resume →", new_resume_path,
          class: "bg-indigo-600 text-white px-5 py-2 rounded hover:bg-indigo-700 font-medium text-sm" %>
    </div>
  <% else %>
    <div class="bg-white border border-gray-200 rounded-lg p-6">
      <%= form_with model: @job, url: jobs_path, local: true, class: "space-y-5" do |f| %>
        <% if @job.errors.any? %>
          <div class="bg-red-50 border border-red-300 rounded p-4 text-sm text-red-700">
            <ul class="list-disc pl-5">
              <% @job.errors.full_messages.each do |msg| %>
                <li><%= msg %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div>
          <%= f.label :resume_id, "Resume to Score Against", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.select :resume_id,
              options_from_collection_for_select(@resumes, :id, :name, @resumes.first.id),
              {},
              id: "resume_select",
              class: "w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400" %>
        </div>

        <div>
          <p class="text-sm font-medium text-gray-700 mb-2">Job Source</p>
          <div class="flex gap-4 text-sm">
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="radio" name="job[source_type]" value="url" id="source_url" class="text-indigo-600">
              <span>Job posting URL</span>
            </label>
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="radio" name="job[source_type]" value="linkedin_id" id="source_linkedin" class="text-indigo-600">
              <span>LinkedIn Job ID</span>
            </label>
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="radio" name="job[source_type]" value="raw_text" id="source_text" class="text-indigo-600">
              <span>Paste job description</span>
            </label>
          </div>
        </div>

        <div id="url_field">
          <%= f.label :url, "Job Posting URL", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.url_field :url, placeholder: "https://jobs.example.com/12345",
              class: "w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400" %>
          <p class="text-xs text-gray-500 mt-1">Indeed, Greenhouse, Lever, and most job boards supported.</p>
        </div>

        <div id="linkedin_field" class="hidden">
          <%= f.label :linkedin_ids, "LinkedIn Job IDs", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_area :linkedin_ids, rows: 10,
              placeholder: "3912345678\n3987654321\n...",
              class: "w-full border border-gray-300 rounded px-3 py-2 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-indigo-400" %>
          <p class="text-xs text-gray-500 mt-1">One ID per line, up to 10. Find the ID in the LinkedIn job URL: linkedin.com/jobs/view/<strong>3912345678</strong></p>
        </div>

        <div id="text_field" class="hidden">
          <%= f.label :raw_text, "Job Description", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_area :raw_text, rows: 10,
              placeholder: "Paste the full job description here...",
              class: "w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400" %>
        </div>

        <div>
          <%= f.label :folder_id, "Folder (optional)", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.select :folder_id,
              options_from_collection_for_select(@folders, :id, :name),
              { include_blank: "No folder" },
              class: "w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400" %>
        </div>

        <%= f.submit "Submit for Scoring",
            class: "bg-indigo-600 text-white px-6 py-2 rounded hover:bg-indigo-700 cursor-pointer font-medium" %>
      <% end %>
    </div>
  <% end %>
</div>

<script>
  const STORAGE_KEY = "resumescorer_job_prefs";
  const radios      = document.querySelectorAll("input[name='job[source_type]']");
  const resumeSel   = document.getElementById("resume_select");
  const fields      = {
    url:         document.getElementById("url_field"),
    linkedin_id: document.getElementById("linkedin_field"),
    raw_text:    document.getElementById("text_field")
  };

  function applySource(val) {
    Object.entries(fields).forEach(([k, el]) => el && el.classList.toggle("hidden", k !== val));
    const radio = document.querySelector(`input[value="${val}"]`);
    if (radio) radio.checked = true;
  }

  function savePrefs() {
    const val = document.querySelector("input[name='job[source_type]']:checked")?.value;
    localStorage.setItem(STORAGE_KEY, JSON.stringify({
      source_type: val,
      resume_id:   resumeSel?.value
    }));
  }

  function loadPrefs() {
    try {
      const prefs = JSON.parse(localStorage.getItem(STORAGE_KEY) || "{}");
      if (prefs.source_type) applySource(prefs.source_type);
      if (prefs.resume_id && resumeSel) {
        const opt = resumeSel.querySelector(`option[value="${prefs.resume_id}"]`);
        if (opt) resumeSel.value = prefs.resume_id;
      }
    } catch(e) {}
    // Ensure one source field is always visible
    if (!document.querySelector("input[name='job[source_type]']:checked")) applySource("url");
  }

  radios.forEach(r => r.addEventListener("change", function() {
    applySource(this.value);
    savePrefs();
  }));

  if (resumeSel) resumeSel.addEventListener("change", savePrefs);

  // Save prefs on submit so the selection persists after the redirect back
  document.querySelector("form")?.addEventListener("submit", savePrefs);

  loadPrefs();
</script>

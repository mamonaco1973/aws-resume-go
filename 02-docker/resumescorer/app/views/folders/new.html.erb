<div class="max-w-md">
  <div class="mb-4">
    <%= link_to "← Folders", folders_path, class: "text-indigo-600 hover:underline text-sm" %>
  </div>

  <h1 class="text-2xl font-bold text-gray-800 mb-6">New Folder</h1>

  <div class="bg-white border border-gray-200 rounded-lg p-6">
    <%= form_with model: @folder, url: folders_path, local: true, class: "space-y-4" do |f| %>
      <% if @folder.errors.any? %>
        <div class="bg-red-50 border border-red-300 rounded p-4 text-sm text-red-700">
          <ul class="list-disc pl-5">
            <% @folder.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <%= f.label :name, "Folder Name", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :name, placeholder: "e.g. Tech Companies",
            class: "w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-400" %>
      </div>

      <%= f.submit "Create Folder",
          class: "bg-indigo-600 text-white px-6 py-2 rounded hover:bg-indigo-700 cursor-pointer font-medium" %>
    <% end %>
  </div>
</div>

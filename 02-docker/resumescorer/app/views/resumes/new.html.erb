<div class="max-w-2xl">
  <div class="mb-4">
    <%= link_to "← My Resumes", resumes_path, class: "text-indigo-600 hover:underline text-sm" %>
  </div>

  <h1 class="text-2xl font-bold text-gray-800 mb-6">Add Resume</h1>

  <div class="bg-white border border-gray-200 rounded-lg p-6">
    <%= form_with model: @resume, url: resumes_path, local: true, class: "space-y-5" do |f| %>
      <% if @resume.errors.any? %>
        <div class="bg-red-50 border border-red-300 rounded p-4 text-sm text-red-700">
          <ul class="list-disc pl-5">
            <% @resume.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <%= f.label :name, "Resume Name", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :name, placeholder: "e.g. Software Engineer Resume 2024",
            class: "w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-400" %>
      </div>

      <div>
        <%= f.label :content_text, "Resume Text", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_area :content_text, rows: 20,
            placeholder: "Paste your resume as plain text here...",
            class: "w-full border border-gray-300 rounded px-3 py-2 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-indigo-400" %>
        <p class="text-xs text-gray-500 mt-1">Paste plain text. If copying from a PDF, use "copy as text" or a tool like pdftotext first.</p>
      </div>

      <%= f.submit "Save Resume",
          class: "bg-indigo-600 text-white px-6 py-2 rounded hover:bg-indigo-700 cursor-pointer font-medium" %>
    <% end %>
  </div>
</div>
